# --- Aplicación ---
APP_NOMBRE=Minimarket POS
ENTORNO=desarrollo
DEBUG=false

# --- Base de datos MySQL 8 (en docker-compose el host es "mysql") ---
DATABASE_URL=mysql+aiomysql://minimarket:minimarket@localhost:3306/minimarket?charset=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- JWT (genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(64))") ---
JWT_SECRET=cambiar-esta-clave-en-produccion
ACCESS_TOKEN_MINUTOS=30
REFRESH_TOKEN_DIAS=7

# --- CORS (separados por comas) ---
CORS_ORIGENES=http://localhost:3000

# --- Usuario administrador inicial ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123*
ADMIN_EMAIL=admin@minimarket.local

# --- Negocio ---
IGV_PORCENTAJE=18
