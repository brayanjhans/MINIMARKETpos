# Variables usadas por docker-compose.yml (copiar a .env en la raíz)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=minimarket
MYSQL_USER=minimarket
MYSQL_PASSWORD=minimarket
MYSQL_PORT=3306

# Puertos propios para no chocar con otros proyectos que usan 3000/8000
BACKEND_PORT=8010
FRONTEND_PORT=3010
WEB_WORKERS=2
